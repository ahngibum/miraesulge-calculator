{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/post/**",
        "function": "servePost"
      },
      {
        "source": "/sitemap.xml",
        "function": "serveSitemap"
      },
      {
        "source": "/manualGeneratePost",
        "function": "manualGeneratePost"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  }
}